// AuraPOS data model — Phase 1 (platform, tenants, stores, users, audit).
// Every tenant-owned table carries tenantId; queries go through lib/db.ts
// helpers that always scope by the signed-in tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  TRIAL
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  STOCK
  TAILOR
  ACCOUNTANT
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

/// One customer business that bought AuraPOS.
model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique // sub-domain: <slug>.aurapos.in
  plan        Plan         @default(TRIAL)
  status      TenantStatus @default(ACTIVE)
  trialEndsAt DateTime?
  barcodeSeq  Int          @default(0) // last in-store barcode number issued
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  stores         Store[]
  users          User[]
  auditLogs      AuditLog[]
  categories     Category[]
  items          Item[]
  variants       Variant[]
  stockMovements StockMovement[]
}

model Store {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  gstin     String?
  upiId     String?
  currency  String   @default("INR")
  timezone  String   @default("Asia/Kolkata")
  invoicePrefix String @default("INV")
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@index([tenantId])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  storeId      String?
  name         String
  email        String?
  phone        String?
  passwordHash String?
  pinHash      String?
  role         Role      @default(CASHIER)
  active       Boolean   @default(true)
  theme        String    @default("emerald")
  themeMode    ThemeMode @default(SYSTEM)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store          Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  auditLogs      AuditLog[]
  stockMovements StockMovement[]

  // Email is unique per business, not globally, so one person can own two shops.
  @@unique([tenantId, email])
  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String // e.g. "user.create", "auth.login", "settings.update"
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

// ─── Catalogue & stock (Phase 2) ────────────────────────────────────────────

enum ItemType {
  GOODS // stock tracked per variant
  SERVICE // alteration, stitching, styling… no stock
  RENTAL // stock tracked, goes out on rent
  NON_INVENTORY // carry bag, custom charge… no stock
}

enum MovementType {
  OPENING
  STOCK_IN
  STOCK_OUT
  DAMAGED
  COUNT_CORRECTION
  SALE
  RETURN
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  Item[]

  @@unique([tenantId, name])
}

model Item {
  id             String   @id @default(cuid())
  tenantId       String
  categoryId     String?
  type           ItemType @default(GOODS)
  name           String
  brand          String?
  collection     String? // season / collection, e.g. "Diwali 2026"
  description    String?
  taxCode        String? // HSN for goods, SAC for services
  gstRateBp      Int      @default(500) // basis points: 500 = 5%
  taxInclusive   Boolean  @default(true)
  priceAtCounter Boolean  @default(false) // service price decided while billing
  turnaroundDays Int? // services: default days until ready
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants Variant[]

  @@index([tenantId, active])
  @@index([tenantId, name])
}

/// A sellable unit. Every item has at least one variant (size/colour may be empty).
model Variant {
  id           String  @id @default(cuid())
  tenantId     String
  itemId       String
  size         String?
  colour       String?
  sku          String
  barcode      String
  mrp          Int // paise
  price        Int // paise, selling price
  cost         Int? // paise, hidden from cashiers
  reorderLevel Int     @default(2)
  // Stock buckets. available = onHand - reserved - inAlteration - damaged
  onHand       Int     @default(0)
  reserved     Int     @default(0)
  inAlteration Int     @default(0)
  damaged      Int     @default(0)
  onRent       Int     @default(0)
  onOrder      Int     @default(0)
  sortOrder    Int     @default(0)
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item      Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([itemId])
}

/// Append-only stock ledger. Stock is never edited without a movement row.
model StockMovement {
  id           String       @id @default(cuid())
  tenantId     String
  variantId    String
  userId       String?
  type         MovementType
  qty          Int // signed change to onHand (or damaged bucket for DAMAGED)
  balanceAfter Int // onHand after this movement
  reason       String?
  createdAt    DateTime     @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([variantId, createdAt])
}
