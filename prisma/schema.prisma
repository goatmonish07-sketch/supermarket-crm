// AuraPOS data model — Phase 1 (platform, tenants, stores, users, audit).
// Every tenant-owned table carries tenantId; queries go through lib/db.ts
// helpers that always scope by the signed-in tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  TRIAL
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  STOCK
  TAILOR
  ACCOUNTANT
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

/// One customer business that bought AuraPOS.
model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique // sub-domain: <slug>.aurapos.in
  plan        Plan         @default(TRIAL)
  status      TenantStatus @default(ACTIVE)
  trialEndsAt DateTime?
  barcodeSeq  Int          @default(0) // last in-store barcode number issued
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  stores         Store[]
  users          User[]
  auditLogs      AuditLog[]
  categories     Category[]
  items          Item[]
  variants       Variant[]
  stockMovements StockMovement[]
  customers      Customer[]
  sales          Sale[]
  heldBills      HeldBill[]
  saleReturns    SaleReturn[]
  orders         Order[]
  measurements   Measurement[]
  docCounters    DocCounter[]
}

enum ReceiptPaper {
  THERMAL_58
  THERMAL_80
  A5
  A4
}

model Store {
  id                   String       @id @default(cuid())
  tenantId             String
  name                 String
  phone                String?
  email                String?
  address              String?
  city                 String?
  state                String?
  pincode              String?
  gstin                String?
  upiId                String?
  currency             String       @default("INR")
  timezone             String       @default("Asia/Kolkata")
  invoicePrefix        String       @default("INV")
  logoUrl              String?
  // Billing & receipts
  receiptPaper         ReceiptPaper @default(THERMAL_80)
  receiptFooter        String?      @default("Thank you for shopping with us!")
  returnPolicy         String?      @default("Exchange within 7 days with bill. No cash refunds on sale items.")
  roundOff             Boolean      @default(true)
  allowNegativeStock   Boolean      @default(false)
  cashierMaxDiscountBp Int          @default(1000) // 10% without manager approval
  monthlyTarget        Int? // paise, for the dashboard gauge
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           User[]
  sales           Sale[]
  invoiceCounters InvoiceCounter[]
  orders          Order[]

  @@index([tenantId])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  storeId      String?
  name         String
  email        String?
  phone        String?
  passwordHash String?
  pinHash      String?
  role         Role      @default(CASHIER)
  active       Boolean   @default(true)
  theme        String    @default("emerald")
  themeMode    ThemeMode @default(SYSTEM)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store          Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  auditLogs      AuditLog[]
  stockMovements StockMovement[]
  salesRung      Sale[]          @relation("cashier")
  salesSold      Sale[]          @relation("salesperson")
  heldBills      HeldBill[]
  saleReturns    SaleReturn[]
  ordersCreated  Order[]         @relation("orderCreator")
  ordersAssigned Order[]         @relation("orderAssignee")
  orderEvents    OrderEvent[]
  orderPayments  OrderPayment[]
  measurements   Measurement[]

  // Email is unique per business, not globally, so one person can own two shops.
  @@unique([tenantId, email])
  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String // e.g. "user.create", "auth.login", "settings.update"
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

// ─── Catalogue & stock (Phase 2) ────────────────────────────────────────────

enum ItemType {
  GOODS // stock tracked per variant
  SERVICE // alteration, stitching, styling… no stock
  RENTAL // stock tracked, goes out on rent
  NON_INVENTORY // carry bag, custom charge… no stock
}

enum MovementType {
  OPENING
  STOCK_IN
  STOCK_OUT
  DAMAGED
  COUNT_CORRECTION
  SALE
  RETURN
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  Item[]

  @@unique([tenantId, name])
}

model Item {
  id             String   @id @default(cuid())
  tenantId       String
  categoryId     String?
  type           ItemType @default(GOODS)
  name           String
  brand          String?
  collection     String? // season / collection, e.g. "Diwali 2026"
  description    String?
  taxCode        String? // HSN for goods, SAC for services
  gstRateBp      Int      @default(500) // basis points: 500 = 5%
  // Garment rule: when the per-piece value is above gstSlabAbove (paise), use gstHighRateBp.
  gstSlabAbove   Int?
  gstHighRateBp  Int?
  taxInclusive   Boolean  @default(true)
  priceAtCounter Boolean  @default(false) // service price decided while billing
  turnaroundDays Int? // services: default days until ready
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants Variant[]

  @@index([tenantId, active])
  @@index([tenantId, name])
}

/// A sellable unit. Every item has at least one variant (size/colour may be empty).
model Variant {
  id           String   @id @default(cuid())
  tenantId     String
  itemId       String
  size         String?
  colour       String?
  sku          String
  barcode      String
  mrp          Int // paise
  price        Int // paise, selling price
  cost         Int? // paise, hidden from cashiers
  reorderLevel Int      @default(2)
  // Stock buckets. available = onHand - reserved - inAlteration - damaged
  onHand       Int      @default(0)
  reserved     Int      @default(0)
  inAlteration Int      @default(0)
  damaged      Int      @default(0)
  onRent       Int      @default(0)
  onOrder      Int      @default(0)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item       Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  movements  StockMovement[]
  saleItems  SaleItem[]
  orderItems OrderItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([itemId])
}

/// Append-only stock ledger. Stock is never edited without a movement row.
model StockMovement {
  id           String       @id @default(cuid())
  tenantId     String
  variantId    String
  userId       String?
  type         MovementType
  qty          Int // signed change to onHand (or damaged bucket for DAMAGED)
  balanceAfter Int // onHand after this movement
  reason       String?
  createdAt    DateTime     @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([variantId, createdAt])
}

// ─── Billing (Phase 3) ───────────────────────────────────────────────────────

enum SaleStatus {
  PAID
  PARTLY_PAID // balance due (credit / khata)
  UNPAID
  CANCELLED
}

enum ReturnState {
  NONE
  PARTLY_RETURNED
  RETURNED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK
  OTHER
}

model Customer {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  phone     String
  email     String?
  birthday  DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales        Sale[]
  orders       Order[]
  measurements Measurement[]

  @@unique([tenantId, phone])
  @@index([tenantId, name])
}

/// Sequential invoice numbers per store and Indian financial year (Apr–Mar).
model InvoiceCounter {
  storeId String
  fy      String // e.g. "2026-27"
  last    Int    @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, fy])
}

model Sale {
  id            String      @id @default(cuid())
  tenantId      String
  storeId       String
  number        String // e.g. DB/2026-27/00042
  fy            String
  seq           Int
  status        SaleStatus  @default(PAID)
  returnState   ReturnState @default(NONE)
  customerId    String?
  cashierId     String?
  salespersonId String?
  // Money in paise
  grossTotal    Int // sum of list price x qty
  discountTotal Int // line + bill discounts
  taxableTotal  Int
  taxTotal      Int
  roundOff      Int
  total         Int // amount payable
  paidTotal     Int
  changeGiven   Int         @default(0)
  refundedTotal Int         @default(0)
  billDiscount  Int         @default(0) // the bill-level part of discountTotal
  approvedById  String? // manager who approved an over-limit discount / price change
  note          String?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime    @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashier     User?        @relation("cashier", fields: [cashierId], references: [id], onDelete: SetNull)
  salesperson User?        @relation("salesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  items       SaleItem[]
  payments    Payment[]
  returns     SaleReturn[]
  order       Order?

  @@unique([storeId, fy, seq])
  @@index([tenantId, createdAt])
  @@index([tenantId, number])
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  variantId    String?
  // Snapshot at time of sale
  name         String
  size         String?
  colour       String?
  sku          String?
  taxCode      String?
  itemType     ItemType
  qty          Int
  unitPrice    Int // list price per unit (paise)
  lineDiscount Int // discount on this line incl. share of bill discount
  taxRateBp    Int
  taxable      Int
  tax          Int
  total        Int // taxable + tax
  returnedQty  Int      @default(0)
  note         String?

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([saleId])
}

model Payment {
  id          String        @id @default(cuid())
  saleId      String
  method      PaymentMethod
  amount      Int // paise; negative for refunds
  reference   String?
  fromAdvance Boolean       @default(false) // settled from an order advance (collected earlier)
  createdAt   DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model SaleReturn {
  id        String        @id @default(cuid())
  tenantId  String
  saleId    String
  userId    String?
  amount    Int // paise refunded
  method    PaymentMethod
  reason    String?
  lines     Json // [{ saleItemId, qty, amount }]
  createdAt DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

/// Parked cart that any counter in the shop can resume.
model HeldBill {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  label     String
  payload   Json
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

// ─── Orders & jobs (Phase 4) ─────────────────────────────────────────────────

enum OrderKind {
  ORDER // special order / booking / delivery
  JOB // alteration or stitching
}

enum OrderStatus {
  // jobs
  RECEIVED
  MEASURED
  CUTTING
  STITCHING
  TRIAL
  // orders
  CONFIRMED
  AWAITING_STOCK
  IN_ALTERATION
  OUT_FOR_DELIVERY
  // shared
  READY
  DELIVERED
  CANCELLED
}

enum DeliveryMode {
  PICKUP
  DELIVERY
}

/// Per-tenant running numbers for documents (ORD-0001, JOB-0001…).
model DocCounter {
  tenantId String
  kind     String
  last     Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, kind])
}

model Measurement {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  label      String // e.g. "Blouse", "Kurti"
  values     Json // { "Bust": 34, "Waist": 30 } in inches
  notes      String?
  takenById  String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  takenBy  User?    @relation(fields: [takenById], references: [id], onDelete: SetNull)
  orders   Order[]

  @@index([customerId, createdAt])
}

model Order {
  id                  String       @id @default(cuid())
  tenantId            String
  storeId             String
  number              String
  kind                OrderKind
  status              OrderStatus
  onHold              Boolean      @default(false)
  customerId          String
  assigneeId          String?
  createdById         String?
  dueDate             DateTime?
  trialDate           DateTime?
  deliveryMode        DeliveryMode @default(PICKUP)
  deliveryAddress     String?
  notes               String?
  designNotes         String?
  measurementId       String?
  measurementSnapshot Json? // copy at order time, so later edits don't change the job card
  estimate            Int // paise, sum of lines
  advancePaid         Int          @default(0)
  saleId              String?      @unique
  completedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignee    User?          @relation("orderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("orderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  measurement Measurement?   @relation(fields: [measurementId], references: [id], onDelete: SetNull)
  sale        Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payments    OrderPayment[]
  events      OrderEvent[]

  @@unique([tenantId, number])
  @@index([tenantId, kind, status])
  @@index([tenantId, dueDate])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  variantId   String
  description String // name + size/colour snapshot
  qty         Int
  price       Int // paise per unit agreed with the customer
  reservedQty Int     @default(0) // units held from stock for this order
  note        String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderPayment {
  id        String        @id @default(cuid())
  orderId   String
  userId    String?
  method    PaymentMethod
  amount    Int // paise
  reference String?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
}

model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  userId    String?
  status    OrderStatus?
  message   String
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}
